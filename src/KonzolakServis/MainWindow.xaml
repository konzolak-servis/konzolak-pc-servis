<Window x:Class="KonzolakServis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konzolák Servis" Icon="Assets/konzolak.ico" Width="1220" Height="800" MinWidth="980" MinHeight="620"
        Background="{StaticResource Pozadi}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Pismo}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Levé menu -->
    <DockPanel Background="{StaticResource Panel}">
      <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
        <Image Source="Assets/logo.png" Width="170" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="servis a údržba PC" Margin="0,8,0,0" Foreground="{StaticResource TextTlumeny}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="20">
        <TextBlock x:Name="AdminInfo" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextTlumeny}"/>
      </StackPanel>
      <StackPanel x:Name="Menu"/>
    </DockPanel>

    <!-- Obsah -->
    <Grid Grid.Column="1" Margin="28,24,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Nadpis" FontSize="24" FontWeight="SemiBold"/>
      <WrapPanel x:Name="Akce" Grid.Row="1" Margin="0,16,0,4"/>

      <!-- Přepínač: čitelný výsledek / podrobný log -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
        <RadioButton x:Name="ZalozkaVysledek" Content="Výsledek" GroupName="pohled" IsChecked="True"
                     Style="{StaticResource Zalozka}" Checked="Pohled_Changed"/>
        <RadioButton x:Name="ZalozkaLog" Content="Podrobný log" GroupName="pohled"
                     Style="{StaticResource Zalozka}" Checked="Pohled_Changed"/>
      </StackPanel>

      <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
        <Grid>
          <ScrollViewer x:Name="VysledekScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="VysledekPanel">
              <TextBlock Text="Vyber akci nahoře. Výsledek se zobrazí tady a můžeš ho uložit tlačítkem „Uložit výsledek…“."
                         TextWrapping="Wrap" Foreground="{StaticResource TextTlumeny}" FontSize="14"/>
            </StackPanel>
          </ScrollViewer>
          <TextBox x:Name="Konzole" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                   Foreground="{StaticResource Text}" FontFamily="{StaticResource PismoKonzole}" FontSize="13"/>
        </Grid>
      </Border>

      <!-- Spodní lišta: stav vlevo (zkracuje se), tlačítka vpravo -->
      <Grid Grid.Row="4" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <ProgressBar x:Name="Prubeh" Width="120" Height="6" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed"
                       Foreground="{StaticResource Akcent}" Background="{StaticResource Panel}" BorderThickness="0"/>
          <TextBlock x:Name="StavText" Foreground="{StaticResource TextTlumeny}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="Zrusit" Content="Zastavit" Style="{StaticResource TlacitkoMale}" IsEnabled="False" Click="Zrusit_Click"/>
          <Button x:Name="UlozitVysledek" Content="Uložit výsledek…" Style="{StaticResource TlacitkoMale}" IsEnabled="False" Click="UlozVysledek_Click"/>
          <Button Content="Uložit celý log…" Style="{StaticResource TlacitkoMale}" Click="UlozLog_Click"/>
          <Button Content="Otevřít složku" Style="{StaticResource TlacitkoMale}" Click="OtevritLogy_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
