<Window x:Class="KonzolakServis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konzolák Servis" Icon="Assets/logo.png" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource Pozadi}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Pismo}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Levé menu -->
    <DockPanel Background="{StaticResource Panel}">
      <StackPanel DockPanel.Dock="Top" Margin="20,24,20,24">
        <Image Source="Assets/logo.png" Width="170" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="servis a údržba PC" Margin="0,8,0,0" Foreground="{StaticResource TextTlumeny}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="20">
        <TextBlock x:Name="AdminInfo" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextTlumeny}"/>
      </StackPanel>
      <StackPanel x:Name="Menu"/>
    </DockPanel>

    <!-- Obsah -->
    <Grid Grid.Column="1" Margin="28,24,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Nadpis" FontSize="24" FontWeight="SemiBold"/>
      <WrapPanel x:Name="Akce" Grid.Row="1" Margin="0,16,0,8"/>

      <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="12">
        <TextBox x:Name="Konzole" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                 FontFamily="{StaticResource PismoKonzole}" FontSize="13"/>
      </Border>

      <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
        <TextBlock x:Name="StavText" VerticalAlignment="Center" Foreground="{StaticResource TextTlumeny}"/>
        <ProgressBar x:Name="Prubeh" Width="160" Height="6" Margin="12,0" IsIndeterminate="True" Visibility="Collapsed"
                     Foreground="{StaticResource Akcent}" Background="{StaticResource Panel}" BorderThickness="0"/>
        <Button DockPanel.Dock="Right" Content="Otevřít složku logů" Style="{StaticResource TlacitkoAkce}" MinWidth="0" Click="OtevritLogy_Click"/>
        <Button DockPanel.Dock="Right" Content="Uložit log (HTML)" Style="{StaticResource TlacitkoAkce}" MinWidth="0" Click="UlozHtml_Click"/>
        <Button DockPanel.Dock="Right" Content="Uložit log (TXT)" Style="{StaticResource TlacitkoAkce}" MinWidth="0" Click="UlozTxt_Click"/>
        <Button DockPanel.Dock="Right" x:Name="Zrusit" Content="Zastavit" Style="{StaticResource TlacitkoAkce}" MinWidth="0"
                IsEnabled="False" Click="Zrusit_Click"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
