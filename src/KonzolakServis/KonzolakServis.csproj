<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KonzolakServis</AssemblyName>
    <RootNamespace>KonzolakServis</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\konzolak.ico</ApplicationIcon>
    <Product>Konzolak service app</Product>
    <Company>Konzolák</Company>
    <!-- Verze = HlavniVerze.CisloBuildu; číslo buildu doplňuje GitHub Actions (každý build +1) -->
    <HlavniVerze>0.15</HlavniVerze>
    <CisloBuildu Condition="'$(CisloBuildu)' == ''">0</CisloBuildu>
    <Version>$(HlavniVerze).$(CisloBuildu)</Version>
    <!-- Odkud se stahují aktualizace (veřejný GitHub repozitář s vydáními) -->
    <RepoAktualizaci Condition="'$(RepoAktualizaci)' == ''">konzolak-servis/konzolak-pc-servis</RepoAktualizaci>
    <AssemblyTitle>Konzolák Servis – diagnostika a údržba PC</AssemblyTitle>
    <Description>Diagnostika, opravy a údržba počítačů se systémem Windows 10 a 11.</Description>
    <Copyright>© Konzolák Zlín</Copyright>
    <NeutralLanguage>cs-CZ</NeutralLanguage>
    <!-- Jeden samostatný .exe, bez nutnosti instalovat .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\konzolak.ico" />
    <EmbeddedResource Include="Novinky.md" LogicalName="Novinky.md" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoAktualizaci</_Parameter1>
      <_Parameter2>$(RepoAktualizaci)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
</Project>
